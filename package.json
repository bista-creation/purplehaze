    "db:local:env": "node scripts/sync-supabase-env.mjs",
    "db:local:verify": "node scripts/verify-local-supabase.mjs",
    "db:local:setup": "npm run db:local:start && npm run db:local:reset && npm run db:local:env && npm run db:seed && npm run db:local:verify",
