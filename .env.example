# ------------------------------------------------------------------
# Purple Haze Restro & Garden — environment template
# Copy to .env for local development, or use these keys on Vercel.
# ------------------------------------------------------------------

# Local Supabase PostgreSQL (Docker Desktop required).
# `npm run db:local:setup` starts the stack, applies migrations, writes the
# generated values to untracked .env.local, and seeds test data.
# NEVER point local development at a hosted/production database.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase local API and short-lived Realtime JWT bridge.
# `npm run db:local:env` fills these in .env.local without printing secrets.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed admin (only used by `npm run db:seed`)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ADMIN_PHONE="+9779800000000"
SEED_ADMIN_NAME="Purple Haze Admin"
# The destructive seed only accepts local SQLite or loopback PostgreSQL on
# 127.0.0.1:54322. It refuses every hosted/production database with no override.

# Email routing — test admin inbox is never shown in the public UI.
ADMIN_NOTIFICATION_EMAIL="admin@example.com"
PUBLIC_CONTACT_EMAIL="purplehaze_biratnagar@gmail.com"

# Email delivery (Resend). Without a key, emails are logged locally.
RESEND_API_KEY=""
EMAIL_FROM="Purple Haze <noreply@your-verified-domain.com>"

# Google login (optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Image uploads (UploadThing). Without a token, external URLs still work.
UPLOADTHING_TOKEN=""

# Production rate limiting (Upstash). Uses in-memory fallback when absent.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Payments — sandbox is safe for local development; live moves real money.
PAYMENT_MODE="sandbox"
# Mock/sandbox modes are blocked when NODE_ENV=production. Set this only on a
# preview deployment that needs test payments. Never enable it in production.
ALLOW_TEST_PAYMENTS="false"
ESEWA_MERCHANT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q"
ESEWA_BASE_URL="https://rc-epay.esewa.com.np/api/epay/main/v2/form"
# Optional override. When empty it is derived from ESEWA_BASE_URL.
ESEWA_STATUS_URL=""
# Your own sandbox server key from https://test-admin.khalti.com (live_secret_key).
# Leave empty to use Khalti's public sandbox demo key (test money only).
KHALTI_SECRET_KEY=""
# Sandbox: https://dev.khalti.com/api/v2 — Production: https://khalti.com/api/v2
KHALTI_BASE_URL="https://dev.khalti.com/api/v2"
