# ------------------------------------------------------------------
# Purple Haze Restro & Garden — environment template
# Copy to .env for local development, or use these keys on Vercel.
# ------------------------------------------------------------------

# Local Supabase PostgreSQL (Docker Desktop required).
# `npm run db:local:setup` starts the stack, applies migrations, writes the
# generated values to untracked .env.local, and seeds test data.
# NEVER point local development at a hosted/production database.
# Prisma Client adds ?pgbouncer=true at runtime to avoid prepared-statement
# failures behind Supabase transaction pooling/PgBouncer. DIRECT_URL stays
# direct for migrations.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Supabase local API and short-lived Realtime JWT bridge.
# `npm run db:local:env` fills these in .env.local without printing secrets.
NEXT_PUBLIC_SUPABASE_URL="http://127.0.0.1:54321"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_JWT_SECRET=""

# Auth.js / public origin
# Local development:
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# On Vercel use the canonical origin WITHOUT a trailing slash:
#   AUTH_URL="https://purplehaze-nine.vercel.app"
#   NEXT_PUBLIC_APP_URL="https://purplehaze-nine.vercel.app"
# Google Cloud Console -> Authorized redirect URI, exactly:
#   https://purplehaze-nine.vercel.app/api/auth/callback/google
# A double slash before /api (//api/...) will not match and Google will return
# redirect_uri_mismatch. Auth.js removes trailing/duplicate slashes from
# AUTH_URL at runtime, but the value registered with Google must still match.

# Demo seed admin (only used by the destructive, loopback-only `npm run db:seed`).
# For an existing hosted database, use `npm run admin:ensure` instead. See README.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="replace-with-a-strong-password"
SEED_ADMIN_PHONE="+9779800000000"
SEED_ADMIN_NAME="Purple Haze Admin"
# The destructive seed only accepts loopback PostgreSQL on 127.0.0.1:54322.
# It refuses every hosted/production database with no override.

# Email routing — test admin inbox is never shown in the public UI.
ADMIN_NOTIFICATION_EMAIL="admin@example.com"
PUBLIC_CONTACT_EMAIL="purplehaze_biratnagar@gmail.com"

# Email delivery (Resend). Without a key, emails are logged locally.
RESEND_API_KEY=""
EMAIL_FROM="Purple Haze <noreply@your-verified-domain.com>"

# Google login (optional). Both values must be present in Vercel and the project
# must be redeployed before the Google buttons appear.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Image uploads. Vercel Blob is used in production when a store is connected;
# UploadThing remains supported. Without either, external URLs still work.
BLOB_READ_WRITE_TOKEN=""
UPLOADTHING_TOKEN=""

# Production rate limiting (Upstash). Uses in-memory fallback when absent.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Payments — sandbox is safe for local development; live moves real money.
PAYMENT_MODE="sandbox"
# Mock/sandbox modes are blocked when NODE_ENV=production. Set this only on a
# preview deployment that needs test payments. Never enable it in production.
ALLOW_TEST_PAYMENTS="false"
ESEWA_MERCHANT_CODE="EPAYTEST"
ESEWA_SECRET_KEY="8gBm/:&EnhH.1/q"
ESEWA_BASE_URL="https://rc-epay.esewa.com.np/api/epay/main/v2/form"
# Optional override. When empty it is derived from ESEWA_BASE_URL.
ESEWA_STATUS_URL=""
# Your own sandbox server key from https://test-admin.khalti.com (live_secret_key).
# Leave empty to use Khalti's public sandbox demo key (test money only).
KHALTI_SECRET_KEY=""
# Sandbox: https://dev.khalti.com/api/v2 — Production: https://khalti.com/api/v2
KHALTI_BASE_URL="https://dev.khalti.com/api/v2"
