# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc & OS
.DS_Store
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
*.pem

# editors
.vscode/*
!.vscode/extensions.json
.idea/
*.sublime-workspace
*.sublime-project

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local database and uploaded files (never commit production data)
/prisma/*.db*

# local Supabase CLI state
/supabase/.branches/
/supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/public/uploads/
